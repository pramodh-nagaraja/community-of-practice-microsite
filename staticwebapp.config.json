{
  "routes": [
    {
      "route": "/.auth/login/aad/callback",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/img/*", "*.{css,scss,gif,ico,jpg,png,js,svg,woff,woff2}"]
  }
}
