{
  "routes": [
    {
      "route": "/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html"
  },
  "trailingSlash": "auto",
  "responseOverrides": {
    "default": {
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}
